# Replace 192.168.1.100 with your computer's local Wi-Fi IPv4 address (run `ipconfig` on Windows)
# Your phone running Expo Go cannot reach "localhost" — it must use your PC's LAN IP.
EXPO_PUBLIC_API_URL=http://192.168.1.100:5000

# Mapbox public access token (starts with pk.eyJ...)
EXPO_PUBLIC_MAPBOX_TOKEN=pk.xxxxx
EXPO_PUBLIC_MAPBOX_STYLE=mapbox/light-v11

# Supabase Auth (Google Sign-In + Profiles)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
